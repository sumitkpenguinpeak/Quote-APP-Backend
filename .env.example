APP_NAME="Quote App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# Production database (MySQL/Postgres) - NOT sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quote_app
DB_USERNAME=quote_app
DB_PASSWORD=

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_APP_URL=https://app.your-domain.com
FRONTEND_URL=https://app.your-domain.com
SHOPIFY_APP_HANDLE=
SHOPIFY_THEME_EXTENSION_UID=
SHOPIFY_SCOPES=read_draft_orders,read_products,read_themes,write_draft_orders,write_content,write_themes
SHOPIFY_BILLING_TRIAL_DAYS=7
# MUST be false in production (real charges). Use true only on a development store.
SHOPIFY_BILLING_TEST_MODE=false

# Extra browser origins allowed for /api (comma separated). Defaults to SHOPIFY_APP_URL.
CORS_ALLOWED_ORIGINS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

# Real queue worker: php artisan queue:work --tries=3 (run under supervisor/systemd)
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/email-config/callback"
